{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "wave": { "type": "string", "pattern": "^onda(?:[1-9]|10)$" },
    "result": {
      "type": "string",
      "enum": [
        "merged",
        "ready-for-merge",
        "not-ready",
        "adjust",
        "blocked",
        "requires-human",
        "failed"
      ]
    },
    "stage": { "type": "string", "minLength": 1 },
    "planPath": { "type": "string" },
    "planSha256": { "type": "string" },
    "branch": { "type": "string" },
    "prNumber": { "type": ["integer", "null"] },
    "auditedHeadSha": { "type": "string" },
    "squashSha": { "type": "string" },
    "message": { "type": "string" },
    "roleTrace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "enum": ["planner", "monitor", "executor", "worker"] },
          "stage": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["role", "stage", "summary"]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "wave",
    "result",
    "stage",
    "planPath",
    "planSha256",
    "branch",
    "prNumber",
    "auditedHeadSha",
    "squashSha",
    "message",
    "roleTrace"
  ]
}
