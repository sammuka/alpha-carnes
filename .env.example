# Database
# - docker compose: o serviço backend sobrescreve para @postgres:5432
# - npm run no host: use localhost:15433 (porta publicada do Postgres)
DATABASE_URL=postgres://alphacarnes:alphacarnes@localhost:15433/alphacarnes

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h

# Cookies
# true em produção (HTTPS), false em desenvolvimento local (HTTP)
COOKIE_SECURE=false

# Rate limiting no /auth/login
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=60000

# Seed
SEED_ADMIN_EMAIL=admin@alphacarnes.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# Backend (Nest escuta PORT; no Docker o host acessa via 4001→3001)
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4000

# Frontend / BFF
# Docker (raiz .env / compose): browser → :4001; BFF container → hostname backend
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_AMBIENTE=Desenvolvimento
BACKEND_INTERNAL_URL=http://backend:3001
# npm run local (app/backend/.env + app/frontend/.env.local):
#   front :4000 | back PORT=4001 | NEXT_PUBLIC/BACKEND_INTERNAL → http://localhost:4001
#   app/frontend/.env.local DEVE repetir JWT_ACCESS_SECRET (mesmo do backend) —
#   sem isso o middleware trata o access_token como inválido, dispara refresh
#   concorrente e a proteção de reuse encerra a sessão (volta ao /login).
