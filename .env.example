# Database
DATABASE_URL=postgres://alphacarnes:alphacarnes@localhost:5432/alphacarnes

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h

# Cookies
# true em produção (HTTPS), false em desenvolvimento local (HTTP)
COOKIE_SECURE=false

# Rate limiting no /auth/login
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=60000

# Seed
SEED_ADMIN_EMAIL=admin@alphacarnes.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# Backend
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Frontend (BFF — server-to-server)
NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_INTERNAL_URL=http://backend:3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
