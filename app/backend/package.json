{
  "name": "@alphacarnes/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/config": "4.0.4",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/passport": "11.0.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.13.1",
    "zod": "4.4.3",
    "nestjs-pino": "4.1.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "@node-rs/argon2": "2.0.2",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.24",
    "@types/express": "5.0.0",
    "@types/node": "22.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.11.10",
    "@types/cookie-parser": "1.4.7",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.31.10",
    "dotenv": "16.4.7",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
